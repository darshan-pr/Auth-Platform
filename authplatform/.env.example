DB_NAME=authplatform
DB_URL=jdbc:postgresql://127.0.0.1:55432/authplatform
COMPOSE_DB_URL=jdbc:postgresql://postgres:5432/authplatform
DB_USER=authplatform
DB_PASSWORD=change-me
REDIS_URL=redis://127.0.0.1:6379
COMPOSE_REDIS_URL=redis://redis:6379
authplatform_KEY_ENCRYPTION_SECRET=replace-with-a-long-random-secret
SMTP_HOST=localhost
SMTP_PORT=1025
COMPOSE_SMTP_HOST=mailpit
COMPOSE_SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=false
SMTP_STARTTLS_ENABLE=false
SMTP_STARTTLS_REQUIRED=false
JWT_ISSUER=http://localhost:8080
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ACCOUNT_ACCESS_TTL=30m
JWT_ACCOUNT_REFRESH_TTL=48h
JWT_ACTIVE_KID=authplatform-dev
JWT_SIGNING_KEYS=
# Optional override; non-production defaults to ~/.authplatform/dev-jwt-signing-key
# JWT_DEVELOPMENT_KEY_FILE=/absolute/path/to/dev-jwt-signing-key
SPRING_PROFILES_ACTIVE=dev
AUTH_COOKIE_SECURE=false
AUTH_DOCS_ENABLED=true
AUDIT_READS_ENABLED=false
VERIFY_TOKEN_TTL=24h
RESET_TOKEN_TTL=30m
LOCKOUT_MAX_FAILURES=5
LOCKOUT_WINDOW=15m
LOCKOUT_DURATION=15m
CONSOLE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
MAX_APPS_PER_ACCOUNT=10
MAX_ORIGINS_PER_APP=20
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_CAPACITY=5
RATE_LIMIT_LOGIN_PERIOD=1m
RATE_LIMIT_SIGNUP_CAPACITY=5
RATE_LIMIT_SIGNUP_PERIOD=10m
RATE_LIMIT_GLOBAL_CAPACITY=1000
RATE_LIMIT_GLOBAL_PERIOD=1m
BACKEND_PORT=8080
SA_BOOTSTRAP_ENABLED=false
SA_BOOTSTRAP_EMAIL=
SA_BOOTSTRAP_NAME=Platform SA
SA_BOOTSTRAP_PASSWORD=
